#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=92
STOP=18
USE_PROCD=1

RUNTIME_JSON="/tmp/tr069-fake-runtime.json"

start_service() {
	local enabled

	config_load tr069_fake
	config_get_bool enabled main enabled 0

	/usr/libexec/tr069-fake-apply reload || return 1
	if [ "$enabled" -eq 1 ] || [ -f /etc/tr069-fake/model.json ]; then
		/usr/sbin/airoha-tr069-fake --config "$RUNTIME_JSON" apply-overlay >/dev/null 2>&1 || true
	fi
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance tr069_fake
	procd_set_param command /usr/sbin/airoha-tr069-fake --config "$RUNTIME_JSON" daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/tr069_fake
	procd_close_instance
}

stop_service() {
	/usr/libexec/tr069-fake-apply stop >/dev/null 2>&1 || true
	rm -f /var/run/airoha-tr069-fake.sock
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger "tr069_fake"
}
