config tr069_fake 'main'
	option enabled '0'
	option omci_sync '0'
	option pon_line 'line0'
	option uplink 'pon0'
	option vlan_id ''
	option macaddr ''
	option option60 ''
	option ipv4_mode 'dhcp'
	option ipv4_addr ''
	option ipv4_mask ''
	option ipv4_gw ''
	option ipv4_dns ''
	option ipv6_mode 'dhcpv6'
	option ipv6_addr ''
	option ipv6_gw ''
	option ipv6_dns ''
	option ip4table '169'
	option ip6table '169'
	option acs_url 'http://acs.example.invalid:9090/acs'
	option acs_username ''
	option acs_password ''
	option insecure_tls '0'
	option periodic_inform_enable '1'
	option periodic_inform_interval '43200'
	option conn_req_enable '0'
	option conn_req_port '7547'
	option conn_req_path '/tr069'
	option conn_req_username ''
	option conn_req_password ''
	option conn_req_allowed_ips ''
	option manufacturer ''
	option oui ''
	option product_class ''
	option serial_number ''
	option hardware_version ''
	option software_version ''
