{
	"luci-app-tr069-fake": {
		"description": "Grant access to dual-stack isolated TR-069 Fake configuration and virtual model",
		"read": {
			"uci": [ "tr069_fake", "network", "pon" ],
			"ubus": {
				"file": [ "exec", "read" ],
				"network.device": [ "status" ],
				"network.interface": [ "dump" ]
			},
			"file": {
				"/usr/libexec/tr069-fake-ctl status": [ "exec" ],
				"/usr/libexec/tr069-fake-ctl model": [ "exec" ],
				"/usr/libexec/tr069-fake-ctl logs": [ "exec" ],
				"/tmp/tr069-fake.log": [ "read" ]
			}
		},
		"write": {
			"uci": [ "tr069_fake" ],
			"ubus": {
				"file": [ "exec" ]
			},
			"file": {
				"/usr/libexec/tr069-fake-ctl trigger-inform": [ "exec" ],
				"/usr/libexec/tr069-fake-ctl reset-virtual": [ "exec" ],
				"/usr/libexec/tr069-fake-ctl apply-overlay": [ "exec" ],
				"/usr/libexec/tr069-fake-ctl clear-log": [ "exec" ]
			}
		}
	}
}
